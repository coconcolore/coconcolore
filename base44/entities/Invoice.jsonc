{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Rechnungsnummer"
    },
    "client_name": {
      "type": "string",
      "description": "Kundenname"
    },
    "client_email": {
      "type": "string",
      "description": "Kunden-E-Mail"
    },
    "client_address": {
      "type": "string",
      "description": "Kundenadresse"
    },
    "items": {
      "type": "array",
      "description": "Rechnungspositionen",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Zwischensumme"
    },
    "tax_rate": {
      "type": "number",
      "description": "Steuersatz in %",
      "default": 19
    },
    "tax_amount": {
      "type": "number",
      "description": "Steuerbetrag"
    },
    "total_amount": {
      "type": "number",
      "description": "Gesamtbetrag"
    },
    "status": {
      "type": "string",
      "enum": [
        "entwurf",
        "gesendet",
        "bezahlt",
        "storniert"
      ],
      "default": "entwurf",
      "description": "Rechnungsstatus"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "F\u00e4lligkeitsdatum"
    },
    "notes": {
      "type": "string",
      "description": "Anmerkungen"
    },
    "course_id": {
      "type": "string",
      "description": "Zugeh\u00f6riger Kurs (optional)"
    }
  },
  "required": [
    "invoice_number",
    "client_name",
    "total_amount"
  ]
}