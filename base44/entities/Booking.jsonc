{
  "name": "Booking",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "amount_total": {
      "type": "number",
      "description": "Gesamtbetrag bezahlt"
    },
    "amount_artist": {
      "type": "number",
      "description": "Betrag an K\u00fcnstler"
    },
    "amount_commission": {
      "type": "number",
      "description": "Provision f\u00fcr Plattform"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "ausstehend",
        "bezahlt",
        "erstattet"
      ],
      "default": "ausstehend"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "course_id",
    "customer_email"
  ]
}